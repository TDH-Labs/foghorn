# Copy to .env.local (gitignored, chmod 600). Never commit or shell-source secrets;
# presence checks must print only boolean/length.

# --- core ---
# HMAC key for pass sentinels. Without it each process uses a random ephemeral key,
# which fails closed across processes (publisher will refuse everything).
FOGHORN_SENTINEL_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=
# Optional per-stage model overrides, e.g. the documented cost knob:
# FOGHORN_MODEL_SCAN=claude-sonnet-5
# FOGHORN_MODEL=            # global override (escape hatch)

# Specialty context (guides the profiler and evidence extraction)
# FOGHORN_BUSINESS_DOMAINS="e-commerce, typescript engineering, indie hacking"

# Alternate provider (config/models.ts activeProvider()). Auto-selected when
# OPENROUTER_API_KEY is set; force either way with FOGHORN_LLM_PROVIDER.
# OPENROUTER_API_KEY=
# FOGHORN_LLM_PROVIDER=openrouter   # or: anthropic

# --- ingestion (Phase 1) ---
BEEPER_ACCESS_TOKEN=        # Beeper Desktop API token (Settings -> Developers)

# --- approvals (Phase 5) ---
FOGHORN_TELEGRAM_BOT_TOKEN= # dedicated BotFather bot, NOT the Claude plugin token
FOGHORN_TELEGRAM_CHAT_ID=   # your personal telegram chat ID (int)

# --- platforms (Phase 3/6) ---
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=      # written by `foghorn connect linkedin authorize` -- don't hand-edit
# LINKEDIN_REFRESH_TOKEN=     # ditto (365-day lifetime; access token is 60-day)
NOSTR_NSEC=

# --- test/dev ---
# FOGHORN_DB=/tmp/foghorn-test.db   # override DB path (tests use :memory:)
